{
  "schema": 1,
  "project": "mspm0-skill",
  "description": "AI Agent skill for Texas Instruments MSPM0 embedded development.",
  "entrypoints": [
    {"path": "SKILL.md", "kind": "skill", "purpose": "General Agent workflow and safety rules"},
    {"path": "README.md", "kind": "overview", "purpose": "Installation, capabilities, examples, and project scope"},
    {"path": "docs/faq.md", "kind": "faq", "purpose": "Answers to common MSPM0, SysConfig, board, and verification questions"},
    {"path": "llms.txt", "kind": "ai-index", "purpose": "Compact AI retrieval summary and canonical links"}
  ],
  "boards": [
    {"id": "tianmengxing", "data": "boards/tianmengxing.json", "docs": "references/boards/tianmengxing.md"},
    {"id": "dimengxing", "data": "boards/dimengxing.json", "docs": "references/boards/dimengxing.md"},
    {"id": "custom-mspm0g3519", "data": "boards/custom-mspm0g3519.json", "docs": "references/boards/custom-mspm0g3519.md"}
  ],
  "tools": [
    {"path": "scripts/check_syscfg.py", "purpose": "Static SysConfig and board-aware pin checks"},
    {"path": "scripts/verify_example.py", "purpose": "Separate static, build, flash, and manual hardware verification stages"},
    {"path": "scripts/capture_example.py", "purpose": "Capture compact examples and generate manifest metadata"},
    {"path": "scripts/list_examples.py", "purpose": "List packaged examples and validate index input"},
    {"path": "scripts/generate_board_docs.py", "purpose": "Generate board Markdown from JSON data"}
  ],
  "examples": [
    {"path": "examples/empty_project", "purpose": "Minimal MSPM0 project snapshot"},
    {"path": "examples/led_blink", "purpose": "GPIO LED example"},
    {"path": "examples/pwm_breath_led", "purpose": "PWM breathing LED example"},
    {"path": "examples/uart_blocking_tx", "purpose": "Blocking UART transmit example"},
    {"path": "examples/oledui_full_g3519", "purpose": "Advanced OLED, IMU, Flash, wireless, and game example"}
  ],
  "validation": {
    "repository": "python3 scripts/validate_repo.py",
    "tests": "python3 -m unittest discover -s tests -v",
    "snapshot": "python3 scripts/check_syscfg.py examples/led_blink --snapshot --strict",
    "generated_docs": "python3 scripts/generate_board_docs.py --check"
  }
}
